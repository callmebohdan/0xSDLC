{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://0xsdlc.local/schemas/route.schema.json",
  "title": "0xSDLC route state",
  "type": "object",
  "required": ["schema_version", "task_id", "request", "workspace", "classification", "model", "status", "current_phase", "phases", "phase_states", "events", "created_at"],
  "properties": {
    "schema_version": {"const": "0.4"},
    "task_id": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}_[a-z0-9-]+_[a-f0-9]{8}$"},
    "request": {"type": "string", "minLength": 1},
    "workspace": {"type": "string", "minLength": 1},
    "classification": {"enum": ["small", "standard", "high-risk"]},
    "model": {"type": "string", "minLength": 1},
    "status": {"enum": ["prepared", "running", "phase-completed", "blocked", "needs-approval", "needs-review", "completed"]},
    "current_phase": {"type": "string"},
    "phases": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "phase_states": {"type": "object", "additionalProperties": {"$ref": "#/$defs/phaseState"}},
    "events": {"type": "array", "items": {"type": "object", "required": ["event", "at"], "properties": {"event": {"type": "string"}, "at": {"type": "string"}, "reason": {"type": "string"}}, "additionalProperties": true}},
    "telemetry": {"$ref": "#/$defs/telemetry"},
    "created_at": {"type": "string"}
  },
  "$defs": {
    "phaseState": {"type": "object", "required": ["status", "attempts", "lanes"], "properties": {"status": {"enum": ["pending", "running", "succeeded", "failed", "blocked", "needs-approval", "skipped"]}, "attempts": {"type": "integer", "minimum": 0}, "lanes": {"type": "object"}}, "additionalProperties": true},
    "telemetry": {"type": "object", "required": ["calls", "duration_ms", "input_tokens", "output_tokens", "cost_usd"], "properties": {"calls": {"type": "integer", "minimum": 0}, "duration_ms": {"type": "integer", "minimum": 0}, "input_tokens": {"type": "integer", "minimum": 0}, "output_tokens": {"type": "integer", "minimum": 0}, "cost_usd": {"type": "number", "minimum": 0}}}
  },
  "additionalProperties": true
}
