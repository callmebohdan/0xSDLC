{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://0xsdlc.local/schemas/route.schema.json",
  "title": "0xSDLC route state",
  "type": "object",
  "required": ["schema_version", "task_id", "request", "workspace", "classification", "mode", "model", "status", "current_phase", "phases", "routing", "phase_states", "events", "created_at"],
  "properties": {
    "schema_version": {"const": "0.5"},
    "task_id": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}_[a-z0-9-]+_[a-f0-9]{8}$"},
    "request": {"type": "string", "minLength": 1},
    "workspace": {"type": "string", "minLength": 1},
    "classification": {"enum": ["small", "standard", "high-risk"]},
    "mode": {"enum": ["change", "diagnose", "assessment"]},
    "model": {"type": "string", "minLength": 1},
    "status": {"enum": ["prepared", "running", "phase-completed", "blocked", "needs-approval", "needs-review", "completed"]},
    "current_phase": {"type": "string"},
    "phases": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "routing": {
      "type": "object",
      "required": ["design", "approval", "maintainability_review", "quality_control"],
      "properties": {
        "design": {"type": "boolean"},
        "approval": {"type": "boolean"},
        "parallel_checks": {"type": "boolean"},
        "maintainability_review": {"type": "boolean"},
        "quality_control": {"type": "boolean"}
      },
      "additionalProperties": true
    },
    "phase_states": {"type": "object", "additionalProperties": {"$ref": "#/$defs/phaseState"}},
    "events": {"type": "array", "items": {"type": "object", "required": ["event", "at"], "properties": {"event": {"type": "string"}, "at": {"type": "string"}, "reason": {"type": "string"}}, "additionalProperties": true}},
    "telemetry": {"$ref": "#/$defs/telemetry"},
    "legacy_telemetry": {"type": "object"},
    "execution": {"enum": ["adapter", "native", "retrospective"]},
    "created_at": {"type": "string"}
  },
  "$defs": {
    "count": {"type": "integer", "minimum": 0},
    "nullableCount": {"type": ["integer", "null"], "minimum": 0},
    "nullableNumber": {"type": ["number", "null"], "minimum": 0},
    "nullableString": {"type": ["string", "null"]},
    "id": {"type": "string", "pattern": "^[a-f0-9]{32}$"},
    "phaseState": {
      "type": "object", "required": ["status", "attempts", "lanes"],
      "properties": {
        "status": {"enum": ["pending", "running", "succeeded", "failed", "blocked", "needs-approval", "needs-review", "skipped"]},
        "attempts": {"$ref": "#/$defs/count"},
        "lanes": {"type": "object"},
        "attempt_history": {"type": "array", "items": {"$ref": "#/$defs/attempt"}}
      },
      "additionalProperties": true
    },
    "attempt": {
      "type": "object",
      "required": ["attempt_id", "source", "provenance", "outcome", "started_at", "finished_at", "duration_ms", "commit_start", "commit_end", "call_ids", "artifacts"],
      "properties": {
        "attempt_id": {"$ref": "#/$defs/id"},
        "source": {"enum": ["adapter", "native"]},
        "provenance": {"enum": ["captured", "retrospective"]},
        "outcome": {"enum": ["running", "succeeded", "failed", "blocked", "needs-review", "interrupted"]},
        "started_at": {"type": "string"},
        "finished_at": {"$ref": "#/$defs/nullableString"},
        "duration_ms": {"$ref": "#/$defs/nullableCount"},
        "commit_start": {"$ref": "#/$defs/nullableString"},
        "commit_end": {"$ref": "#/$defs/nullableString"},
        "call_ids": {"type": "array", "items": {"$ref": "#/$defs/id"}, "uniqueItems": true},
        "artifacts": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      }
    },
    "telemetry": {
      "type": "object",
      "required": ["calls", "duration_ms", "input_tokens", "output_tokens", "cost_usd"],
      "properties": {
        "calls": {"$ref": "#/$defs/count"},
        "duration_ms": {"$ref": "#/$defs/nullableCount"},
        "input_tokens": {"$ref": "#/$defs/nullableCount"},
        "output_tokens": {"$ref": "#/$defs/nullableCount"},
        "cache_read_tokens": {"$ref": "#/$defs/nullableCount"},
        "cache_write_tokens": {"$ref": "#/$defs/nullableCount"},
        "reasoning_tokens": {"$ref": "#/$defs/nullableCount"},
        "inference_ms": {"$ref": "#/$defs/nullableNumber"},
        "cost_usd": {"$ref": "#/$defs/nullableNumber"},
        "coverage": {"type": "object", "additionalProperties": {"$ref": "#/$defs/count"}}
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"mode": {"enum": ["diagnose", "assessment"]}}},
      "then": {"properties": {"phases": {"not": {"contains": {"enum": ["implement", "fix", "approval"]}}}}}
    }
  ],
  "additionalProperties": true
}
