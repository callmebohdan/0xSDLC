{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://0xsdlc.local/schemas/artifact.schema.json",
  "title": "0xSDLC Markdown artifact front matter",
  "type": "object",
  "required": ["schema_version", "task_id", "phase", "status"],
  "properties": {
    "schema_version": {"enum": ["0.1", "0.2"]},
    "task_id": {"type": "string", "minLength": 1},
    "phase": {"type": "string", "minLength": 1},
    "status": {"enum": ["ready", "needs-review", "blocked", "verified"]},
    "decision": {"enum": ["approve", "fix", "needs-review"]},
    "blocking_findings": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "route_add": {"type": "array", "items": {"enum": ["design", "approval"]}, "uniqueItems": true},
    "route_reason": {"type": "string"},
    "risk_level": {"enum": ["low", "medium", "high"]}
  },
  "allOf": [
    {"if": {"properties": {"phase": {"const": "review"}}}, "then": {"required": ["decision"]}},
    {"if": {"properties": {"decision": {"const": "fix"}}}, "then": {"required": ["blocking_findings"]}}
  ],
  "additionalProperties": true
}
